# Vite client-side configuration
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_OCR_ENDPOINT=

# Server-side only. NEVER prefix this with VITE_ and NEVER expose it in client code.
# Add this in Netlify -> Site configuration -> Environment variables.
MAILBOXLAYER_API_KEY=YOUR_MAILBOXLAYER_KEY
